      "validation": {
        "enum": [
          "HTTP",
          "WEBSOCKET"
        ]
      },
      "helpText": "The API protocol."
    },
    {
      "key": "description",
      "tfPath": "description",
      "label": "Description",
      "section": "general",
      "order": 3,
      "required": false,
      "helpText": "Description of the API."
    },
    {
      "key": "tags",
      "tfPath": "tags",
      "label": "Tags",
      "section": "general",
      "order": 4,
      "type": "map"
    }
