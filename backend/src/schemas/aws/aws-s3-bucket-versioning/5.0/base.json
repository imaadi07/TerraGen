{
  "providerKey": "aws",
  "terraformType": "aws_s3_bucket_versioning",
  "canvasType": "aws-s3-bucket-versioning",
  "displayName": "AWS S3 Bucket Versioning",
  "category": "storage",
  "icon": "Storage",
  "color": "#3F8600",
  "compatibleWith": ">=5.0.0 <7.0.0",
  "dependencies": [
    {
      "resourceType": "aws-s3",
