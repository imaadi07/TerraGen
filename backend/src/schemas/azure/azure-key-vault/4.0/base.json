{
  "providerKey": "azure",
  "terraformType": "azurerm_key_vault",
  "canvasType": "azure-key-vault",
  "displayName": "Azure Key Vault",
  "icon": "Lock",
  "color": "#0078D4",
  "compatibleWith": ">=4.0.0 <5.0.0",
  "category": "security",
  "description": "Safeguard cryptographic keys and secrets used by cloud apps and services.",
  "sections": [
    {
      "key": "general",
      "label": "General",
      "order": 1,
      "defaultExpanded": true,
      "collapsible": false
    }
