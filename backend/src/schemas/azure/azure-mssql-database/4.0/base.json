  "displayName": "Azure SQL Database",
  "icon": "Database",
  "color": "#0078D4",
  "compatibleWith": ">=4.0.0 <5.0.0",
  "category": "database",
  "description": "Deploy a managed relational SQL Database on Azure SQL Server.",
  "sections": [
    {
      "key": "general",
      "label": "General",
      "order": 1,
      "defaultExpanded": true,
      "collapsible": false
