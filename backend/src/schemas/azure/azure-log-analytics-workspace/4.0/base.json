      "tfPath": "resource_group_name",
      "label": "Resource Group Name",
      "section": "general",
      "order": 3,
      "required": true,
      "default": "rg-app-production"
    },
    {
      "key": "sku",
      "tfPath": "sku",
      "label": "Pricing SKU",
      "section": "general",
      "order": 4,
      "default": "PerGB2018",
      "validation": {
        "enum": [
          "PerGB2018",
          "Free",
          "Standalone"
        ]
      }
    },
    {
      "key": "retentionInDays",
      "tfPath": "retention_in_days",
      "label": "Retention (Days)",
      "section": "general",
      "order": 5,
      "default": 30,
      "validation": {
        "type": "number"
      }
    },
    {
      "key": "tags",
      "tfPath": "tags",
      "label": "Tags",
      "section": "general",
      "order": 6,
      "validation": {
        "type": "map"
      }
    }
