    {
      "key": "ipConfigurationPrivateIpAllocation",
      "tfPath": "ip_configuration.private_ip_address_allocation",
      "label": "Private IP Allocation",
      "section": "general",
      "order": 6,
      "default": "Dynamic",
      "validation": {
        "enum": [
          "Dynamic",
          "Static"
        ]
      }
    },
    {
      "key": "ipConfigurationPublicIpId",
      "tfPath": "ip_configuration.public_ip_address_id",
      "label": "Public IP ID",
      "section": "general",
      "order": 7
    },
    {
      "key": "tags",
      "tfPath": "tags",
      "label": "Tags",
      "section": "general",
      "order": 8,
      "validation": {
