      "section": "general",
      "order": 4,
      "default": "internal"
    },
    {
      "key": "ipConfigurationSubnetId",
      "tfPath": "ip_configuration.subnet_id",
      "label": "Subnet ID",
      "section": "general",
      "order": 5,
      "required": true
