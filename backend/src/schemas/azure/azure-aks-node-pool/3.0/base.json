        "enum": [
          "User",
          "System"
        ]
      }
    },
    {
      "key": "vnetSubnetId",
      "tfPath": "vnet_subnet_id",
      "label": "Subnet ID",
      "section": "general",
      "order": 6
    },
    {
      "key": "tags",
      "tfPath": "tags",
      "label": "Tags",
      "section": "general",
      "order": 7,
      "validation": {
        "type": "map"
      }
