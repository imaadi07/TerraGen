      "order": 1,
      "required": true,
      "default": "userpool"
    },
    {
      "key": "kubernetesClusterId",
      "tfPath": "kubernetes_cluster_id",
      "label": "AKS Cluster ID",
      "section": "general",
      "order": 2,
      "required": true
    },
    {
      "key": "vmSize",
      "tfPath": "vm_size",
      "label": "VM Size",
      "section": "general",
      "order": 3,
      "default": "Standard_D4s_v5",
      "validation": {
        "enum": [
          "Standard_D2s_v5",
          "Standard_D4s_v5",
          "Standard_D8s_v5"
        ]
      }
    },
    {
      "key": "nodeCount",
      "tfPath": "node_count",
