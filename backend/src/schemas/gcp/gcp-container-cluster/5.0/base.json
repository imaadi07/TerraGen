{
  "providerKey": "gcp",
  "terraformType": "google_container_cluster",
  "canvasType": "gcp-container-cluster",
  "displayName": "GKE Kubernetes Cluster",
  "category": "compute",
  "icon": "Compute",
  "color": "#4285F4",
  "compatibleWith": ">=5.0.0 <7.0.0",
  "dependencies": [
    {
      "resourceType": "gcp-compute-network",
      "terraformType": "google_compute_network",
      "displayName": "VPC Network",
      "reason": "GKE cluster must reside within a VPC network.",
      "linkField": "network",
      "tfOutputRef": "google_compute_network.{resourceName}.name",
      "required": false
    },
    {
      "resourceType": "gcp-compute-subnetwork",
      "terraformType": "google_compute_subnetwork",
      "displayName": "Subnetwork",
      "reason": "Subnetwork for GKE cluster nodes and pods.",
      "linkField": "subnetwork",
      "tfOutputRef": "google_compute_subnetwork.{resourceName}.name",
      "required": false
    }
  ],
  "sections": [
    {
      "key": "general",
      "label": "Cluster Settings",
      "order": 1,
      "defaultExpanded": true,
      "collapsible": false
    },
    {
      "key": "networking",
      "label": "Networking & Security",
      "order": 2,
      "defaultExpanded": true,
      "collapsible": true
    }
  ],
  "fields": [
    {
      "key": "name",
      "tfPath": "name",
      "label": "Cluster Name",
      "sectionKey": "general",
      "order": 1,
      "type": "string",
      "required": true,
      "placeholder": "prod-gke-cluster",
      "description": "Unique name of the GKE cluster."
    },
    {
      "key": "location",
      "tfPath": "location",
      "label": "Region / Zone",
      "sectionKey": "general",
      "order": 2,
      "type": "string",
      "required": true,
      "defaultValue": "us-central1",
      "placeholder": "us-central1",
      "description": "Region or zone where the cluster control plane is located."
    },
    {
      "key": "initialNodeCount",
      "tfPath": "initial_node_count",
      "label": "Initial Node Count",
      "sectionKey": "general",
      "order": 3,
      "type": "number",
      "required": false,
      "defaultValue": 1,
      "description": "Number of nodes to create in the cluster."
    },
    {
      "key": "removeDefaultNodePool",
      "tfPath": "remove_default_node_pool",
      "label": "Remove Default Node Pool",
      "sectionKey": "general",
      "order": 4,
      "type": "boolean",
      "required": false,
      "defaultValue": true,
      "description": "Best practice: remove default pool and manage dedicated node pools."
    },
    {
      "key": "enableAutopilot",
      "tfPath": "enable_autopilot",
      "label": "Enable GKE Autopilot",
      "sectionKey": "general",
      "order": 5,
      "type": "boolean",
      "required": false,
      "defaultValue": false,
      "description": "Enable Google-managed Autopilot mode for automated cluster operations."
    },
    {
      "key": "deletionProtection",
      "tfPath": "deletion_protection",
      "label": "Deletion Protection",
      "sectionKey": "general",
      "order": 6,
      "type": "boolean",
      "required": false,
      "defaultValue": false,
      "description": "Whether to protect the cluster against accidental deletion via Terraform."
    },
    {
      "key": "network",
      "tfPath": "network",
      "label": "VPC Network",
      "sectionKey": "networking",
      "order": 1,
      "type": "string",
      "required": false,
      "description": "VPC network name. Auto-populated by canvas link."
    },
    {
      "key": "subnetwork",
      "tfPath": "subnetwork",
      "label": "Subnetwork",
      "sectionKey": "networking",
      "order": 2,
      "type": "string",
      "required": false,
      "description": "Subnetwork name. Auto-populated by canvas link."
    }
  ],
  "version": "5.0"
}
