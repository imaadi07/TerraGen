      "required": true,
      "default": "regional-backend-service"
    },
    {
      "key": "region",
      "tfPath": "region",
      "label": "Region",
      "section": "general",
      "order": 2,
      "required": true,
      "default": "us-central1"
    },
    {
      "key": "protocol",
      "tfPath": "protocol",
      "label": "Protocol",
      "section": "general",
      "order": 3,
      "default": "TCP",
      "validation": {
        "enum": [
          "TCP",
          "UDP",
          "HTTP",
          "HTTPS",
          "GRPC"
        ]
      }
    },
    {
      "key": "loadBalancingScheme",
      "tfPath": "load_balancing_scheme",
      "label": "Scheme",
      "section": "general",
      "order": 4,
      "default": "INTERNAL",
      "validation": {
        "enum": [
          "INTERNAL",
          "INTERNAL_MANAGED",
          "EXTERNAL"
        ]
      }
    },
    {
      "key": "healthChecks",
      "tfPath": "health_checks",
      "label": "Health Checks",
